# requests.eo — طلبات HTTP بسهولة، مثل requests في بايثون
#
#   import requests
#   var r = requests.get("https://api.github.com/users/octocat")
#   print r.status_code, r.json()["name"]
#
#   var r2 = requests.get(url, {"Authorization": "Bearer ..."}, "http://127.0.0.1:8080")
#                         ^      ^ headers                       ^ proxy
#
# مكتوبة بـ eo فوق http()، بدون أي تعديل في اللغة.

const VERSION = "1.0.0"

# الهيدرز اللي تنرسل مع كل طلب (تقدر تغيّرها: requests.default_headers["User-Agent"] = "...")
var default_headers = {"User-Agent": "eo-requests/" + VERSION, "Accept": "*/*"}

const REASONS = {200: "OK", 201: "Created", 202: "Accepted", 204: "No Content", 301: "Moved Permanently", 302: "Found", 304: "Not Modified", 307: "Temporary Redirect", 308: "Permanent Redirect", 400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found", 405: "Method Not Allowed", 408: "Request Timeout", 409: "Conflict", 410: "Gone", 413: "Payload Too Large", 415: "Unsupported Media Type", 422: "Unprocessable Entity", 429: "Too Many Requests", 500: "Internal Server Error", 501: "Not Implemented", 502: "Bad Gateway", 503: "Service Unavailable", 504: "Gateway Timeout"}

# ═════════════════════════════════════════════
#  Response
# ═════════════════════════════════════════════

struct Response {
    status_code @int
    ok @bool = false
    reason @string
    text @string
    # البايتات زي ما هي (للصور والملفات): write_file "a.png", r.content
    content @string
    headers @map
    url @string
    method @string
    # كم ثانية أخذ الطلب
    elapsed @float = 0.0
    # لو ما وصل للسيرفر أصلًا (نت، رابط غلط...): السبب هنا و status_code = 0
    error @string
    data
}

# r.json()  → قاموس أو قائمة
func Response.json {
    if self.data != none {
        return self.data
    }
    return json_decode(self.text)
}

# يوقف الكود بخطأ لو الطلب فشل (4xx أو 5xx أو ما وصل)
#   استخدمه داخل prc لو تبي تمسك الخطأ
func Response.raise_for_status {
    if self.ok {
        return self
    }
    var why = h"${self.status_code} ${self.reason} for url: ${self.url}"
    if self.status_code == 0 {
        why = h"Connection error for url: ${self.url} (${self.error})"
    }
    var stop = {}
    return stop[h"HTTPError ${why}"]
}

# هيدر بدون ما يفرق كبير وصغير: r.header("Content-Type")
func Response.header name @string, default = "" {
    return pick(self.headers, lower(name), default)
}

# يحفظ الجواب في ملف (صورة، zip ...) ويرجع true لو نجح
func Response.save path @string {
    if not self.ok {
        return false
    }
    write_file path, self.content
    return true
}

# ═════════════════════════════════════════════
#  الطلبات
# ═════════════════════════════════════════════

# requests.get("https://...")
# requests.get("https://...", {"Authorization": "..."})
# requests.get("https://...", {}, "http://127.0.0.1:8080")
func get url @string, headers @map = {}, proxy @string = "" {
    return request("GET", url, none, headers, proxy)
}

# body: قاموس أو قائمة (ينرسل JSON)، أو نص كما هو
func post url @string, body = none, headers @map = {}, proxy @string = "" {
    return request("POST", url, body, headers, proxy)
}

func put url @string, body = none, headers @map = {}, proxy @string = "" {
    return request("PUT", url, body, headers, proxy)
}

func patch url @string, body = none, headers @map = {}, proxy @string = "" {
    return request("PATCH", url, body, headers, proxy)
}

func delete url @string, headers @map = {}, proxy @string = "" {
    return request("DELETE", url, none, headers, proxy)
}

func head url @string, headers @map = {}, proxy @string = "" {
    return request("HEAD", url, none, headers, proxy)
}

func request method @string, url @string, body = none, headers @map = {}, proxy @string = "" {
    var r = Response{url: url, method: upper(method)}
    if not use_proxy(proxy) {
        r.error = "proxy can only be set before the first request (" + proxy_note + ")"
        r.reason = "Proxy Error"
        return r
    }
    if not (startswith(lower(url), "http://") or startswith(lower(url), "https://")) {
        r.error = "the url must start with http:// or https://"
        r.reason = "Invalid URL"
        return r
    }
    var all = {}
    for k in keys(default_headers) {
        all[k] = default_headers[k]
    }
    for k in keys(headers) {
        all[k] = string(headers[k])
    }
    var start = now()
    var res = http(upper(method), url, body, all)
    r.elapsed = now() - start
    r.status_code = res["status"]
    r.text = res["body"]
    r.content = res["body"]
    r.headers = res["headers"]
    r.error = res["error"]
    r.data = res["json"]
    r.ok = r.status_code >= 200 and r.status_code < 400
    r.reason = pick(REASONS, r.status_code, "")
    if r.status_code == 0 {
        r.reason = "Connection Error"
    }
    return r
}

# ينزّل ملف: requests.download("https://.../logo.png", "logo.png")
func download url @string, path @string, headers @map = {}, proxy @string = "" {
    var r = get(url, headers, proxy)
    r.save(path)
    return r
}

# ═════════════════════════════════════════════
#  Proxy
# ═════════════════════════════════════════════
# eo تقرأ البروكسي من HTTP_PROXY و HTTPS_PROXY مرة وحدة أول طلب،
# فالبروكسي لازم ينحط في أول طلب (أو بـ requests.set_proxy قبله)، ويبقى لكل البرنامج.

var current_proxy = ""
var first_done = false
const proxy_note = "eo reads the proxy once, at the first request"

# requests.set_proxy "http://127.0.0.1:8080"   (قبل أي طلب)
func set_proxy proxy @string {
    return use_proxy(proxy)
}

func use_proxy proxy @string {
    if proxy == "" or proxy == current_proxy {
        first_done = true
        return true
    }
    if first_done {
        print "[requests] can't switch to proxy " + proxy + ": " + proxy_note + ". Set it in your first request."
        return false
    }
    var p = proxy
    if not ("://" in p) {
        p = "http://" + p
    }
    var tmp = ".eo_requests_proxy.env"
    write_file tmp, "HTTP_PROXY=" + p + "\nHTTPS_PROXY=" + p + "\nhttp_proxy=" + p + "\nhttps_proxy=" + p + "\n"
    load_env(tmp)
    delete_file(tmp)
    current_proxy = proxy
    first_done = true
    return true
}

# ═════════════════════════════════════════════
#  أدوات
# ═════════════════════════════════════════════

# يشفّر النص للرابط صح (& و = و المسافة والعربي)
func quote text {
    var safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
    var out = ""
    for b in bytes(string(text)) {
        var ch = chr(b)
        if b < 128 and ch in safe {
            out = out + ch
        } else {
            out = out + "%" + upper(hex(b, 2))
        }
    }
    return out
}

# requests.url("https://api.com/search", {"q": "eo & go", "page": 2})
#   → "https://api.com/search?q=eo%20%26%20go&page=2"
func url base @string, params @map {
    if len(keys(params)) == 0 {
        return base
    }
    var parts = []
    for k in keys(params) {
        append parts, quote(k) + "=" + quote(params[k])
    }
    var sep = "?"
    if "?" in base {
        sep = "&"
    }
    return base + sep + join(parts, "&")
}

# بيانات فورم: requests.post(url, requests.form({"user": "ali"}), requests.FORM)
func form fields @map {
    var parts = []
    for k in keys(fields) {
        append parts, quote(k) + "=" + quote(fields[k])
    }
    return join(parts, "&")
}

const FORM = {"Content-Type": "application/x-www-form-urlencoded"}
const JSON = {"Content-Type": "application/json"}

# Bearer token: requests.get(url, requests.bearer("TOKEN"))
func bearer token @string {
    return {"Authorization": "Bearer " + token}
}

# Basic auth: requests.get(url, requests.basic("user", "pass"))
func basic user @string, password @string {
    return {"Authorization": "Basic " + base64(user + ":" + password)}
}

func base64 text {
    var abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var b = bytes(string(text))
    var out = ""
    var i = 0
    while i < len(b) {
        var n = shl(b[i], 16)
        var count = 1
        if i + 1 < len(b) {
            n = bit_or(n, shl(b[i + 1], 8))
            count = 2
        }
        if i + 2 < len(b) {
            n = bit_or(n, b[i + 2])
            count = 3
        }
        out = out + slice(abc, bit_and(shr(n, 18), 63), bit_and(shr(n, 18), 63) + 1)
        out = out + slice(abc, bit_and(shr(n, 12), 63), bit_and(shr(n, 12), 63) + 1)
        if count > 1 {
            out = out + slice(abc, bit_and(shr(n, 6), 63), bit_and(shr(n, 6), 63) + 1)
        } else {
            out = out + "="
        }
        if count > 2 {
            out = out + slice(abc, bit_and(n, 63), bit_and(n, 63) + 1)
        } else {
            out = out + "="
        }
        i += 3
    }
    return out
}

# get(map, key, default) حق eo (الاسم get محجوز لـ requests.get داخل المكتبة)
func pick m @map, key, default {
    if has(m, key) {
        return m[key]
    }
    return default
}

# يدمج قواميس هيدرز: requests.merge(requests.bearer(t), {"Accept": "text/html"})
func merge a @map, b @map {
    var out = {}
    for k in keys(a) {
        out[k] = a[k]
    }
    for k in keys(b) {
        out[k] = b[k]
    }
    return out
}
